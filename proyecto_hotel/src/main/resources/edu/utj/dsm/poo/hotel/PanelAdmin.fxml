<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1130.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.dsm.poo.hotel.controlador.PanelAdminController">
   <children>
      <BorderPane fx:id="contenedor" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="lblNombreHotel" text="Hotel">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblUsuarioActual" text="Usuario actual">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Button mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar Sesión" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>
         <left>
            <VBox prefWidth="150.0" spacing="8.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="btnInicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarInicio" text="Inicio / Dashboard" />
                  <Button fx:id="btnClientes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirClientes" text="Clientes" />
                  <Button fx:id="btnEmpleados" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirEmpleados" text="Empleados" />
                  <Button fx:id="btnHabitaciones" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirHabitaciones" text="Habitaciones" />
                  <Button fx:id="btnReservas" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirReservas" text="Reservas" />
                  <Button fx:id="btnConfiguracion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Configuración Hotel" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox fx:id="panelCentral" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox spacing="15.0">
                     <children>
                        <VBox prefWidth="120.0">
                           <children>
                              <Label fx:id="lblReservasDia" text="Reservas del Día" />
                              <Label text="12" />
                           </children>
                        </VBox>
                        <VBox prefWidth="120.0">
                           <children>
                              <Label text="Hab. Libres" />
                              <Label fx:id="lblHabitacionesLibres" text="18 / 30" />
                           </children>
                        </VBox>
                        <VBox prefWidth="140.0">
                           <children>
                              <Label text="Usuarios Conectados" />
                              <Label text="4" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <TableView fx:id="tblActividad" prefHeight="400.0" prefWidth="600.0">
                     <columns>
                        <TableColumn fx:id="colFechaHora" prefWidth="160.0" text="Fecha y Hora" />
                        <TableColumn fx:id="colUsuario" prefWidth="120.0" text="Usuario" />
                        <TableColumn fx:id="colAccion" prefWidth="320.0" text="Acción Realizada" />
                     </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
